# Copy to .env.local for local dev, and set the same values in
# Vercel → Settings → Environment Variables for production.
#
# Anything with a VITE_ prefix is compiled into the PUBLIC JavaScript bundle
# and is visible to every visitor. Only put public-by-design values there.
# Anything without the prefix stays server-side and is safe for secrets.

# ── Public (safe in the bundle) ────────────────────────────────
# Nothing public is needed right now. The browser talks only to /api on the
# same origin; it never holds a database key or a payment credential.

# ── SECRET (server-side only — never add a VITE_ prefix) ───────
# Razorpay key secret, used by api/verify-booking.ts to verify that a visitor
# landing on /teach actually paid. Razorpay dashboard →
# Account & Settings → API Keys. Until this is set, the booking page falls
# back to a weak params-only check that a determined visitor can replay.
RAZORPAY_KEY_SECRET=

# Active 60-minute Calendly event URL, handed out only after a verified
# payment. The profile URL is not enough: this must point directly to a
# published event that currently accepts bookings.
CALENDLY_URL=

# Razorpay key id (the rzp_live_... one). Public by nature, but kept
# server-side because it is only used to call the Razorpay API from
# api/_lib/razorpay.ts to look up a buyer's email and phone after payment.
# Without it, bookings are still recorded, just without contact details.
RAZORPAY_KEY_ID=

# Supabase. The service role key BYPASSES row-level security — it is the most
# dangerous value in this file. Server-side only, never VITE_-prefixed, never
# returned in a response. Dashboard → Project Settings → API → service_role.
SUPABASE_URL=https://rrqndfahvlxdzslxhzzo.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
